{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Yarp.ReverseProxy": "Information"
        }
    },
    "AllowedHosts": "*",
    "ReverseProxy": {
        "Routes": {
            "auths": {
                "ClusterId": "identity",
                "Match": {
                    "Path": "/api/v1/auths/{**remainder}"
                },
                "Transforms": [
                    {
                        "RequestHeaderRemove": "X-Service-Key"
                    },
                    {
                        "RequestHeaderRemove": "X-Forwarded-For"
                    },
                    {
                        "RequestHeaderRemove": "X-Forwarded-Host"
                    },
                    {
                        "RequestHeaderRemove": "X-Forwarded-Proto"
                    }
                ]
            },
            "admin": {
                "ClusterId": "identity",
                "Match": {
                    "Path": "/api/v1/admin/{**remainder}"
                },
                "Transforms": [
                    {
                        "RequestHeaderRemove": "X-Service-Key"
                    },
                    {
                        "RequestHeaderRemove": "X-Forwarded-For"
                    },
                    {
                        "RequestHeaderRemove": "X-Forwarded-Host"
                    },
                    {
                        "RequestHeaderRemove": "X-Forwarded-Proto"
                    }
                ]
            },
            "tenants": {
                "ClusterId": "organization",
                "Match": {
                    "Path": "/api/v1/tenants/{**remainder}"
                },
                "Transforms": [
                    {
                        "RequestHeaderRemove": "X-Service-Key"
                    },
                    {
                        "RequestHeaderRemove": "X-Forwarded-For"
                    },
                    {
                        "RequestHeaderRemove": "X-Forwarded-Host"
                    },
                    {
                        "RequestHeaderRemove": "X-Forwarded-Proto"
                    }
                ]
            },
            "organizations": {
                "ClusterId": "organization",
                "Match": {
                    "Path": "/api/v1/organizations/{**remainder}"
                },
                "Transforms": [
                    {
                        "RequestHeaderRemove": "X-Service-Key"
                    },
                    {
                        "RequestHeaderRemove": "X-Forwarded-For"
                    },
                    {
                        "RequestHeaderRemove": "X-Forwarded-Host"
                    },
                    {
                        "RequestHeaderRemove": "X-Forwarded-Proto"
                    }
                ]
            },
            "branches": {
                "ClusterId": "organization",
                "Match": {
                    "Path": "/api/v1/branches/{**remainder}"
                },
                "Transforms": [
                    {
                        "RequestHeaderRemove": "X-Service-Key"
                    },
                    {
                        "RequestHeaderRemove": "X-Forwarded-For"
                    },
                    {
                        "RequestHeaderRemove": "X-Forwarded-Host"
                    },
                    {
                        "RequestHeaderRemove": "X-Forwarded-Proto"
                    }
                ]
            },
            "warehouses": {
                "ClusterId": "organization",
                "Match": {
                    "Path": "/api/v1/warehouses/{**remainder}"
                },
                "Transforms": [
                    {
                        "RequestHeaderRemove": "X-Service-Key"
                    },
                    {
                        "RequestHeaderRemove": "X-Forwarded-For"
                    },
                    {
                        "RequestHeaderRemove": "X-Forwarded-Host"
                    },
                    {
                        "RequestHeaderRemove": "X-Forwarded-Proto"
                    }
                ]
            },
            "pos": {
                "ClusterId": "organization",
                "Match": {
                    "Path": "/api/v1/pos/{**remainder}"
                },
                "Transforms": [
                    {
                        "RequestHeaderRemove": "X-Service-Key"
                    },
                    {
                        "RequestHeaderRemove": "X-Forwarded-For"
                    },
                    {
                        "RequestHeaderRemove": "X-Forwarded-Host"
                    },
                    {
                        "RequestHeaderRemove": "X-Forwarded-Proto"
                    }
                ]
            }
        },
        "Clusters": {
            "identity": {
                "Destinations": {
                    "primary": {
                        "Address": "http://localhost:5168/"
                    }
                },
                "HttpRequest": {
                    "ActivityTimeout": "00:00:30"
                }
            },
            "organization": {
                "Destinations": {
                    "primary": {
                        "Address": "http://localhost:5102/"
                    }
                },
                "HttpRequest": {
                    "ActivityTimeout": "00:00:30"
                }
            }
        }
    }
}
